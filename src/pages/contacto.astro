---
import BaseLayout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

---

<BaseLayout title="Contacto - Joyería JON" description="Contáctanos para pedidos, consultas o atención personalizada.">
  <Header />

  <section class="contacto">
    <div class="contacto-container">
      <img src="src/icons/logojon.png" class="logo" />

      <h1>Contáctanos</h1>
      <p>Estamos aquí para ayudarte. Puedes escribirnos o seguirnos en nuestras redes sociales.</p>

      <div class="info">
        <h2> Teléfono</h2>
        <p><a href="https://wa.me/573001112233" target="_blank">+57 300 111 2233</a></p>

        <h2> Correo</h2>
        <p><a href="mailto:joyeriajon@gmail.com">joyeriajon@gmail.com</a></p>

        <h2> Dirección</h2>
        <p>Cra 10 #20-30, Pasto, Nariño, Colombia</p>
      </div>

      <div class="redes">
        <h2>Síguenos</h2>
        <div class="icons">
          <a href="https://www.facebook.com/joyeriajon" target="_blank">
            <img src="src/icons/facebook.png" alt="Facebook" />
          </a>
          <a href="https://www.instagram.com/joyeriajon" target="_blank">
            <img src="src/icons/instagram.png" alt="Instagram" />
          </a>
          <a href="https://wa.me/573001112233" target="_blank">
            <img src="src/icons/whatsapp.webp" alt="WhatsApp" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .contacto {
    background: linear-gradient(135deg, #000, #1a1a1a);
    color: #fff;
    padding: 4rem 1rem;
    text-align: center;
  }

  .contacto-container {
    max-width: 800px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: 16px;
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
  }

  .logo {
    width: 80px;
    margin-bottom: 1rem;
    filter: drop-shadow(0 0 10px #d4af37);
  }

  h1 {
    color: #d4af37;
    font-family: "Playfair Display", serif;
    margin-bottom: 1rem;
  }

  .info h2 {
    color: #d4af37;
    margin-top: 1rem;
  }

  .info a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s;
  }

  .info a:hover {
    color: #d4af37;
  }

  .redes {
    margin-top: 2rem;
  }

  .icons {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  .icons img {
    width: 50px;
    height: 50px;
    transition: transform 0.3s, filter 0.3s;
  }

  .icons img:hover {
    transform: scale(1.1);
    filter: drop-shadow(0 0 10px #d4af37);
  }
</style>
