---
// Props para el título y el cuerpo del contenido
const { title } = Astro.props;
---
<section class="content-section">
    <h2>{title}</h2>
    <slot />
</section>

<style>
    .content-section {
        padding: 20px;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
        margin-bottom: 20px;
    }
    h2 {
        color: #0056b3;
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
        margin-top: 0;
    }
</style>