---
const { title } = Astro.props;
---
<section class="content-section">
  <h2>{title}</h2>
  <slot />
</section>

<style>
  .content-section {
    padding: 2rem;
    background-color: #111;
    border-radius: 12px;
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.1);
    margin-bottom: 2rem;
  }
  h2 {
    color: #d4af37;
    border-bottom: 2px solid #d4af37;
    padding-bottom: 0.5rem;
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
  }
  p, li {
    color: #ddd;
    line-height: 1.6;
  }
</style>
