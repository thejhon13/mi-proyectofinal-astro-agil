---
---
<header class="header">
  <div class="container header-content">
    <h1 class="logo">
      Joyería JON 
      <img src="/icons/logojon.png" alt="Logo Joyería JON" class="logo-img" />
    </h1>
    <nav>
  <nav>
  <a href="/" class="nav-btn">Inicio</a>
  <a href="/productos" class="nav-btn">Colección</a>
  <a href="/contacto" class="nav-btn">Contacto</a>
  <a href="/compras" class="btn-compras">Compras</a>
</nav>
  </div>
</header>

<style>
  .header {
    background: linear-gradient(90deg, #000, #1a1a1a);
    color: #d4af37;
    padding: 1rem 0;
    box-shadow: 0 2px 10px rgba(212, 175, 55, 0.2);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    letter-spacing: 1px;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .logo-img {
    width: 40px;
    height: auto;
    filter: drop-shadow(0 0 6px #d4af37);
  }

  nav {
    display: flex;
    align-items: center;
  }

  .nav-btn {
    color: #fff;
    background-color: #000;
    border: 2px solid #d4af37;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    margin-left: 1rem;
    transition: all 0.3s ease;
  }

  .nav-btn:hover {
    background-color: #d4af37;
    color: #000;
    transform: translateY(-2px);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
  }

  .btn-compras {
    background-color: #d4af37;
    color: #000;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
    margin-left: 1.5rem;
    transition: background 0.3s, transform 0.2s;
    display: inline-block;
  }

  .btn-compras:hover {
    background-color: #b99c30;
    transform: translateY(-2px);
  }
  
</style>
